LOCALLINK_ADDR=:8080
LOCALLINK_DB=data/locallink.db
LOCALLINK_NAME=LocalLink Server
# Required outside development/test; use a high-entropy enrollment secret (minimum 16 chars).
LOCALLINK_PAIRING_CODE=
LOCALLINK_FILES_DIR=data/files
# Maximum uploaded file size in MiB. Default: 50.
LOCALLINK_MAX_FILE_MB=50

# Phase 12 security: enable HTTPS/WSS by setting both paths.
# LOCALLINK_TLS_CERT=/path/to/cert.pem
# LOCALLINK_TLS_KEY=/path/to/key.pem
# WebSocket credentials are always header-only. Query-string bearer tokens are unsupported.
# TLS is required by default. Set false only for local development/testing.
LOCALLINK_REQUIRE_TLS=true
# Local-only admin panel token. Admin routes are disabled when unset.
# Leave blank to disable bootstrap admin creation; when set, use a unique 16+ character secret.
LOCALLINK_ADMIN_BOOTSTRAP_USERNAME=admin
LOCALLINK_ADMIN_BOOTSTRAP_PASSWORD=
LOCALLINK_BACKUP_DIR=data/backups

# Phase 42 production storage quota per device (default 1024 MB)
LOCALLINK_MAX_STORAGE_PER_DEVICE_MB=1024
