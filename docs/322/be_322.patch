diff --git a/internal/httpapi/version_rule_322.go b/internal/httpapi/version_rule_322.go
new file mode 100644
index 0000000..ba25643
--- /dev/null
+++ b/internal/httpapi/version_rule_322.go
@@ -0,0 +1,116 @@
+package httpapi
+
+// Bundle 322 (W4): the App version page picks the build from what is really
+// on this server. V1: GET /api/v1/admin/version-rule also returns `uploads`
+// (the APKs the owner put here). V5: a rule for a build that is not on the
+// server is refused, but only when the page asks for it (`require_upload322`),
+// so scripted / older callers keep working exactly as in 321.
+
+import (
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// versionUpload322 is one row of the pick list. Additive JSON: an old web
+// bundle ignores it.
+type versionUpload322 struct {
+	ID         int64  `json:"id"`
+	Version    string `json:"version"`
+	Build      int64  `json:"build"`
+	FileName   string `json:"file_name"`
+	Size       int64  `json:"size"`
+	SHA256     string `json:"sha256"`
+	AddedAt    string `json:"added_at"`
+	AddedBy    string `json:"added_by"`
+	Downloads  int64  `json:"downloads"`
+	Current    bool   `json:"current"`          // the download this server serves now
+	IsRule     bool   `json:"is_rule"`          // the saved rule points at this build
+	OnDisk     bool   `json:"on_disk"`          // the file is still there
+	PhonesHere int    `json:"phones_here"`      // 30 days, phones on exactly this build
+	Newest     bool   `json:"newest,omitempty"` // the newest upload (by build)
+}
+
+// versionUploads322 lists the APKs on this server, newest build first.
+func (a *API) versionUploads322(ruleBuild int64) []versionUpload322 {
+	out := []versionUpload322{}
+	rows, err := a.store.DB().Query(`SELECT ` + apkCols299 + ` FROM app_apk_299 ORDER BY build DESC, id DESC LIMIT 50`)
+	if err != nil {
+		return out
+	}
+	defer rows.Close()
+	for rows.Next() {
+		row, scanErr := scanAPK299(rows)
+		if scanErr != nil {
+			continue
+		}
+		out = append(out, versionUpload322{
+			ID: row.ID, Version: row.Version, Build: row.Build, FileName: row.FileName,
+			Size: row.Size, SHA256: row.SHA256, AddedAt: row.AddedAt, AddedBy: row.AddedBy,
+			Downloads: row.Downloads, Current: row.Current,
+			IsRule: ruleBuild > 0 && row.Build == ruleBuild,
+			OnDisk: a.apkOnDisk299(row.FileName),
+		})
+	}
+	if len(out) > 0 {
+		out[0].Newest = true
+	}
+	// How many phones are on exactly this build (30 days). One query.
+	since := time.Now().UTC().Add(-30 * 24 * time.Hour).Format(time.RFC3339Nano)
+	phones := map[int64]int{}
+	if pr, err := a.store.DB().Query(`SELECT build,COUNT(*) FROM device_builds WHERE seen_at>=? GROUP BY build`, since); err == nil {
+		for pr.Next() {
+			var b int64
+			var n int
+			if pr.Scan(&b, &n) == nil {
+				phones[b] = n
+			}
+		}
+		pr.Close()
+	}
+	for i := range out {
+		out[i].PhonesHere = phones[out[i].Build]
+	}
+	return out
+}
+
+// buildOnServer322: is this build one of the APKs this server has?
+func (a *API) buildOnServer322(build int64) bool {
+	if build < 1 {
+		return false
+	}
+	var n int
+	if err := a.store.DB().QueryRow(`SELECT COUNT(*) FROM app_apk_299 WHERE build=?`, build).Scan(&n); err != nil {
+		return false
+	}
+	return n > 0
+}
+
+// uploadPayload322: the small shape the page's pick list needs.
+func (a *API) uploadPayload322(ruleBuild int64) map[string]any {
+	uploads := a.versionUploads322(ruleBuild)
+	var newest any
+	if len(uploads) > 0 {
+		newest = uploads[0]
+	}
+	return map[string]any{"uploads": uploads, "newest_upload": newest}
+}
+
+// versionRuleGet322 wraps the 321 GET body with the new keys.
+func (a *API) versionRuleGet322(w http.ResponseWriter, r *http.Request, body map[string]any, ruleBuild int64) {
+	for k, v := range a.uploadPayload322(ruleBuild) {
+		body[k] = v
+	}
+	writeJSON(w, http.StatusOK, body)
+}
+
+// apkOnDisk299: is the file still in the APK folder? (nil-safe for tests)
+func (a *API) apkOnDisk299(name string) bool {
+	if strings.TrimSpace(name) == "" {
+		return false
+	}
+	_, err := os.Stat(filepath.Join(a.apkDir299(), name))
+	return err == nil
+}
diff --git a/internal/httpapi/version_rule_322_test.go b/internal/httpapi/version_rule_322_test.go
new file mode 100644
index 0000000..df1485f
--- /dev/null
+++ b/internal/httpapi/version_rule_322_test.go
@@ -0,0 +1,122 @@
+package httpapi
+
+// Bundle 322 (W4 / V1 + V5 + V7): the App version page picks the build from
+// what is on the server. Old callers must see exactly the 321 behaviour.
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"testing"
+)
+
+func jsonUnmarshal322(b []byte, v any) error { return json.Unmarshal(b, v) }
+
+// numOf322 reads a number out of a decoded JSON map (float64 or json.Number).
+func numOf322(v any) int64 {
+	switch n := v.(type) {
+	case float64:
+		return int64(n)
+	case int64:
+		return n
+	case json.Number:
+		i, _ := n.Int64()
+		return i
+	case string:
+		i, _ := strconv.ParseInt(n, 10, 64)
+		return i
+	}
+	return 0
+}
+
+// list322 calls the admin GET and returns the decoded body.
+func list322(t *testing.T, e apkEnv299) map[string]any {
+	t.Helper()
+	rec := e.get(t, e.api.AdminGetVersionRule, "/api/v1/admin/version-rule", "", map[string]string{
+		"Authorization": "Bearer " + e.token,
+	})
+	if rec.Code != http.StatusOK {
+		t.Fatalf("GET version-rule %d %s", rec.Code, rec.Body.String())
+	}
+	out := map[string]any{}
+	if err := jsonUnmarshal322(rec.Body.Bytes(), &out); err != nil {
+		t.Fatalf("body: %v", err)
+	}
+	return out
+}
+
+func TestVersionRule322ReturnsUploads(t *testing.T) {
+	e := newAPKEnv299(t)
+	key := cert299(t, "sajjad")
+	if code, out := e.upload(t, apk299Bytes(t, "com.sajjad.linkup", 183, "3.0.112", key)); code != http.StatusOK {
+		t.Fatalf("upload 183: %d %v", code, out)
+	}
+	if code, out := e.upload(t, apk299Bytes(t, "com.sajjad.linkup", 184, "3.0.113", key)); code != http.StatusOK {
+		t.Fatalf("upload 184: %d %v", code, out)
+	}
+	// The rule is behind the newest upload - the case the page must show.
+	setRule213(t, e.api, e.token, map[string]any{"min_build": 183, "min_version": "3.0.112", "mode": "warn"})
+
+	body := list322(t, e)
+	// 321 keys are untouched.
+	if body["rule"] == nil || body["builds"] == nil {
+		t.Fatalf("321 keys missing: %v", body)
+	}
+	uploads, ok := body["uploads"].([]any)
+	if !ok || len(uploads) != 2 {
+		t.Fatalf("uploads: %T %v", body["uploads"], body["uploads"])
+	}
+	newest := uploads[0].(map[string]any)
+	if numOf322(newest["build"]) != 184 || newest["newest"] != true {
+		t.Fatalf("newest must be build 184: %v", newest)
+	}
+	if newest["is_rule"] != false {
+		t.Fatalf("184 is not the rule: %v", newest)
+	}
+	if newest["on_disk"] != true {
+		t.Fatalf("the file is on the server: %v", newest)
+	}
+	old := uploads[1].(map[string]any)
+	if numOf322(old["build"]) != 183 || old["is_rule"] != true {
+		t.Fatalf("183 is the rule: %v", old)
+	}
+	if top, ok := body["newest_upload"].(map[string]any); !ok || numOf322(top["build"]) != 184 {
+		t.Fatalf("newest_upload: %v", body["newest_upload"])
+	}
+}
+
+func TestVersionRule322NoUploadsKeepsTheOldShape(t *testing.T) {
+	e := newAPKEnv299(t)
+	body := list322(t, e)
+	uploads, ok := body["uploads"].([]any)
+	if !ok || len(uploads) != 0 {
+		t.Fatalf("no uploads expected: %v", body["uploads"])
+	}
+	if body["newest_upload"] != nil {
+		t.Fatalf("newest_upload must be nil: %v", body["newest_upload"])
+	}
+	// A rule can still be saved with no APK at all (typed by hand).
+	setRule213(t, e.api, e.token, map[string]any{"min_build": 150, "min_version": "3.0.90", "mode": "warn"})
+	if body := list322(t, e); body["rule"] == nil {
+		t.Fatalf("the rule was not saved: %v", body)
+	}
+}
+
+func TestVersionRule322RefusesABuildThatIsNotOnTheServer(t *testing.T) {
+	e := newAPKEnv299(t)
+	key := cert299(t, "sajjad")
+	if code, out := e.upload(t, apk299Bytes(t, "com.sajjad.linkup", 184, "3.0.113", key)); code != http.StatusOK {
+		t.Fatalf("upload: %d %v", code, out)
+	}
+	// The page asks for the guard: a build nobody can download is refused.
+	res := doJSON(t, e.api.AdminSetVersionRule, http.MethodPost, "/api/v1/admin/version-rule",
+		map[string]any{"min_build": 999, "min_version": "9.9.9", "mode": "warn", "require_upload322": true},
+		map[string]string{"Authorization": "Bearer " + e.token})
+	if res.Code != http.StatusBadRequest {
+		t.Fatalf("expected 400 for a build not on the server, got %d %s", res.Code, res.Body.String())
+	}
+	// A build that IS on the server is accepted.
+	setRule213(t, e.api, e.token, map[string]any{"min_build": 184, "min_version": "3.0.113", "mode": "warn", "require_upload322": true})
+	// And a caller that does not send the flag keeps the 321 behaviour.
+	setRule213(t, e.api, e.token, map[string]any{"min_build": 999, "min_version": "9.9.9", "mode": "warn"})
+}
