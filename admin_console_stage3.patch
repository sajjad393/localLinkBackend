+/* ===========================================================================
+   LocalLink administration console — design system
+   Tokens mirror the Flutter admin theme (AdminPalette) so the browser console
+   and the in-app admin surface stay visually identical.
+   =========================================================================== */
+
+:root {
+  /* Surfaces */
+  --background: #f5f6f8;
+  --surface: #ffffff;
+  --surface-muted: #f2f4f7;
+  --surface-raised: #ffffff;
+  --border: #e2e6ec;
+  --border-strong: #cfd6e0;
+  --hover: rgba(17, 24, 39, 0.04);
+  --selected: rgba(30, 91, 255, 0.08);
+  --sidebar: #ffffff;
+  --topbar: #ffffff;
+
+  /* Text */
+  --text-primary: #111827;
+  --text-secondary: #5b6472;
+  --text-tertiary: #8b93a1;
+
+  /* Brand */
+  --primary: #1e5bff;
+  --primary-soft: #e8eeff;
+  --on-primary: #ffffff;
+
+  /* Semantic */
+  --success: #0f7b52;
+  --success-soft: #e4f5ec;
+  --warning: #9a5b06;
+  --warning-soft: #fdf1dd;
+  --danger: #b42318;
+  --danger-soft: #fdebe9;
+  --info: #0b5fa5;
+  --info-soft: #e7f1fb;
+
+  --chart-grid: #e8ebf0;
+  --shadow: 0 1px 2px rgba(16, 24, 40, 0.06), 0 1px 3px rgba(16, 24, 40, 0.08);
+
+  /* Spacing scale */
+  --space-xxs: 2px;
+  --space-xs: 4px;
+  --space-sm: 8px;
+  --space-md: 12px;
+  --space-lg: 16px;
+  --space-xl: 20px;
+  --space-xxl: 24px;
+  --space-xxxl: 32px;
+  --space-page: 24px;
+
+  /* Radii */
+  --radius-xs: 4px;
+  --radius-sm: 6px;
+  --radius-md: 8px;
+  --radius-lg: 12px;
+  --radius-pill: 999px;
+
+  /* Layout */
+  --sidebar-width: 248px;
+  --sidebar-compact: 76px;
+  --topbar-height: 60px;
+  --content-max: 1600px;
+
+  --font-sans: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+  --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
+
+  color-scheme: light;
+}
+
+[data-theme="dark"] {
+  --background: #0d1014;
+  --surface: #151920;
+  --surface-muted: #1b2029;
+  --surface-raised: #1d222b;
+  --border: #262c36;
+  --border-strong: #343c48;
+  --hover: rgba(255, 255, 255, 0.06);
+  --selected: rgba(91, 140, 255, 0.14);
+  --sidebar: #151920;
+  --topbar: #151920;
+
+  --text-primary: #e8edf4;
+  --text-secondary: #9ca6b5;
+  --text-tertiary: #6b7686;
+
+  --primary: #5b8cff;
+  --primary-soft: #1d2740;
+  --on-primary: #08111f;
+
+  --success: #3ed598;
+  --success-soft: #14301f;
+  --warning: #e9a94f;
+  --warning-soft: #33260f;
+  --danger: #f0776c;
+  --danger-soft: #361a18;
+  --info: #6faef0;
+  --info-soft: #12273b;
+
+  --chart-grid: #232935;
+  --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 2px 6px rgba(0, 0, 0, 0.35);
+
+  color-scheme: dark;
+}
+
+/* --------------------------------------------------------------------------
+   Base
+   -------------------------------------------------------------------------- */
+
+* { box-sizing: border-box; }
+
+html, body { height: 100%; }
+
+body {
+  margin: 0;
+  font-family: var(--font-sans);
+  font-size: 13.5px;
+  line-height: 1.45;
+  color: var(--text-primary);
+  background: var(--background);
+  -webkit-font-smoothing: antialiased;
+}
+
+h1, h2, h3, h4 { margin: 0; font-weight: 600; }
+p { margin: 0; }
+button, input, select, textarea { font: inherit; color: inherit; }
+a { color: var(--primary); text-decoration: none; }
+a:hover { text-decoration: underline; }
+.hidden { display: none !important; }
+.mono { font-family: var(--font-mono); font-size: 12px; }
+.muted { color: var(--text-secondary); }
+.subtle { color: var(--text-tertiary); }
+.nowrap { white-space: nowrap; }
+.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.grow { flex: 1; min-width: 0; }
+.stack { display: flex; flex-direction: column; }
+.row { display: flex; align-items: center; }
+.gap-xs { gap: var(--space-xs); }
+.gap-sm { gap: var(--space-sm); }
+.gap-md { gap: var(--space-md); }
+.gap-lg { gap: var(--space-lg); }
+
+:focus-visible {
+  outline: 2px solid var(--primary);
+  outline-offset: 2px;
+  border-radius: var(--radius-xs);
+}
+
+::-webkit-scrollbar { width: 10px; height: 10px; }
+::-webkit-scrollbar-track { background: transparent; }
+::-webkit-scrollbar-thumb {
+  background: var(--border-strong);
+  border: 3px solid transparent;
+  background-clip: content-box;
+  border-radius: var(--radius-pill);
+}
+::-webkit-scrollbar-thumb:hover { background: var(--text-tertiary); background-clip: content-box; }
+
+/* Type scale */
+.type-page-title { font-size: 20px; font-weight: 650; letter-spacing: -0.01em; }
+.type-section-title { font-size: 16px; font-weight: 600; }
+.type-card-title { font-size: 14px; font-weight: 600; }
+.type-caption { font-size: 12px; color: var(--text-secondary); }
+.type-label {
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--text-tertiary);
+}
+.type-metric { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; }
+
+/* --------------------------------------------------------------------------
+   Buttons
+   -------------------------------------------------------------------------- */
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-sm);
+  height: 36px;
+  padding: 0 var(--space-md);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--surface);
+  color: var(--text-primary);
+  font-weight: 600;
+  cursor: pointer;
+  transition: background 120ms ease, border-color 120ms ease, opacity 120ms ease;
+}
+.btn:hover:not(:disabled) { background: var(--surface-muted); }
+.btn:disabled { opacity: 0.5; cursor: not-allowed; }
+.btn-primary { background: var(--primary); border-color: var(--primary); color: var(--on-primary); }
+.btn-primary:hover:not(:disabled) { filter: brightness(1.06); background: var(--primary); }
+.btn-danger { background: var(--danger); border-color: var(--danger); color: #fff; }
+.btn-danger:hover:not(:disabled) { filter: brightness(1.06); background: var(--danger); }
+.btn-ghost { background: transparent; border-color: transparent; color: var(--text-secondary); }
+.btn-ghost:hover:not(:disabled) { background: var(--hover); color: var(--text-primary); }
+.btn-sm { height: 30px; padding: 0 var(--space-sm); font-size: 12.5px; }
+.btn-block { width: 100%; }
+.btn-icon {
+  width: 36px; height: 36px; padding: 0;
+  border-radius: var(--radius-md);
+  display: inline-flex; align-items: center; justify-content: center;
+  background: transparent; border: 1px solid transparent; color: var(--text-secondary); cursor: pointer;
+}
+.btn-icon:hover:not(:disabled) { background: var(--hover); color: var(--text-primary); }
+.btn-icon:disabled { opacity: 0.5; cursor: not-allowed; }
+.btn-icon .icon { width: 18px; height: 18px; }
+
+.icon { width: 16px; height: 16px; display: block; stroke: currentColor; fill: none; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
+
+/* --------------------------------------------------------------------------
+   Login
+   -------------------------------------------------------------------------- */
+
+.auth {
+  min-height: 100vh;
+  display: grid;
+  grid-template-columns: minmax(360px, 5fr) minmax(360px, 4fr);
+  background: var(--background);
+}
+.auth-brand {
+  position: relative;
+  padding: var(--space-xxxl);
+  color: #fff;
+  background: linear-gradient(140deg, #1e5bff 0%, #4b7dff 55%, #22c3ff 100%);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-lg);
+}
+.auth-brand .brand-row { display: flex; align-items: center; gap: var(--space-md); }
+.auth-brand .brand-mark {
+  width: 36px; height: 36px; border-radius: var(--radius-md);
+  background: rgba(255, 255, 255, 0.18);
+  display: grid; place-items: center;
+}
+.auth-brand h1 { font-size: 32px; line-height: 1.2; font-weight: 700; margin-top: auto; }
+.auth-brand .lede { color: rgba(255, 255, 255, 0.82); max-width: 46ch; }
+.auth-brand ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-lg); }
+.auth-brand li { display: flex; gap: var(--space-md); align-items: flex-start; }
+.auth-brand li strong { display: block; font-size: 13.5px; }
+.auth-brand li span { color: rgba(255, 255, 255, 0.75); font-size: 12px; line-height: 1.4; }
+.auth-note {
+  margin-top: auto;
+  display: flex; gap: var(--space-sm);
+  padding: var(--space-md);
+  border-radius: var(--radius-md);
+  background: rgba(255, 255, 255, 0.12);
+  color: rgba(255, 255, 255, 0.82);
+  font-size: 11.5px; line-height: 1.45;
+}
+.auth-form-wrap { display: grid; place-items: center; padding: var(--space-xxxl) var(--space-page); }
+.auth-form { width: min(420px, 100%); display: grid; gap: var(--space-lg); }
+.auth-form .mark {
+  width: 34px; height: 34px; border-radius: var(--radius-md);
+  background: linear-gradient(140deg, var(--primary), var(--info));
+  display: grid; place-items: center; color: #fff;
+}
+.field { display: grid; gap: var(--space-xs); }
+.field > label { font-weight: 600; font-size: 12.5px; color: var(--text-secondary); }
+.input {
+  height: 40px;
+  padding: 0 var(--space-md);
+  border: 1px solid var(--border-strong);
+  border-radius: var(--radius-md);
+  background: var(--surface);
+  color: var(--text-primary);
+  width: 100%;
+}
+.input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--selected); }
+.input::placeholder { color: var(--text-tertiary); }
+select.input { height: 34px; }
+.input-affix { position: relative; }
+.input-affix .btn-icon { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); }
+.form-error {
+  display: flex; gap: var(--space-sm); align-items: flex-start;
+  padding: var(--space-md);
+  border-radius: var(--radius-md);
+  background: var(--danger-soft);
+  color: var(--danger);
+  font-size: 12.5px;
+}
+.form-error[hidden] { display: none; }
+
+/* --------------------------------------------------------------------------
+   App frame
+   -------------------------------------------------------------------------- */
+
+.app { display: flex; min-height: 100vh; }
+.sidebar {
+  width: var(--sidebar-width);
+  flex: 0 0 var(--sidebar-width);
+  background: var(--sidebar);
+  border-right: 1px solid var(--border);
+  display: flex;
+  flex-direction: column;
+  position: sticky;
+  top: 0;
+  height: 100vh;
+  transition: width 160ms ease, flex-basis 160ms ease;
+  z-index: 30;
+}
+.app.collapsed .sidebar { width: var(--sidebar-compact); flex-basis: var(--sidebar-compact); }
+.sidebar-head {
+  height: var(--topbar-height);
+  display: flex; align-items: center; gap: var(--space-md);
+  padding: 0 var(--space-lg);
+  border-bottom: 1px solid var(--border);
+  flex: 0 0 var(--topbar-height);
+}
+.app.collapsed .sidebar-head { padding: 0 var(--space-md); justify-content: center; }
+.brand-mark {
+  width: 30px; height: 30px; min-width: 30px; border-radius: var(--radius-md);
+  background: linear-gradient(140deg, #1e5bff, #22c3ff);
+  display: grid; place-items: center; color: #fff;
+}
+.brand-text { display: grid; line-height: 1.2; }
+.brand-text strong { font-size: 13.5px; }
+.brand-text span { font-size: 11.5px; color: var(--text-tertiary); }
+.app.collapsed .brand-text { display: none; }
+.sidebar-nav { overflow-y: auto; padding: var(--space-md) 0; flex: 1; }
+.nav-group-title {
+  padding: var(--space-md) var(--space-lg) var(--space-sm);
+  font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
+  color: var(--text-tertiary);
+}
+.app.collapsed .nav-group-title { display: none; }
+.app.collapsed .nav-group + .nav-group { border-top: 1px solid var(--border); margin-top: var(--space-sm); padding-top: var(--space-sm); }
+.nav-item {
+  display: flex; align-items: center; gap: var(--space-md);
+  margin: var(--space-xxs) var(--space-sm);
+  padding: 0 var(--space-md);
+  height: 38px;
+  border: 1px solid transparent;
+  border-radius: var(--radius-sm);
+  background: transparent;
+  color: var(--text-secondary);
+  font-weight: 500;
+  cursor: pointer;
+  width: calc(100% - var(--space-sm) * 2);
+  text-align: left;
+  position: relative;
+}
+.nav-item:hover { background: var(--hover); color: var(--text-primary); }
+.nav-item.active {
+  background: var(--selected);
+  border-color: color-mix(in srgb, var(--primary) 35%, transparent);
+  color: var(--text-primary);
+  font-weight: 600;
+}
+.nav-item .icon { width: 18px; height: 18px; flex: 0 0 18px; }
+.nav-item.active .icon { color: var(--primary); }
+.nav-item .nav-label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.nav-item .nav-meta { font-size: 10.5px; color: var(--text-tertiary); }
+.nav-badge {
+  min-width: 20px; height: 18px; padding: 0 6px;
+  border-radius: var(--radius-pill);
+  background: var(--danger); color: #fff;
+  font-size: 10.5px; font-weight: 700;
+  display: inline-flex; align-items: center; justify-content: center;
+}
+.app.collapsed .nav-label, .app.collapsed .nav-badge, .app.collapsed .nav-item .nav-meta { display: none; }
+.app.collapsed .nav-item { justify-content: center; padding: 0; }
+.sidebar-foot { border-top: 1px solid var(--border); padding: var(--space-sm); }
+
+.shell { flex: 1; min-width: 0; display: flex; flex-direction: column; }
+.topbar {
+  height: var(--topbar-height);
+  flex: 0 0 var(--topbar-height);
+  display: flex; align-items: center; gap: var(--space-md);
+  padding: 0 var(--space-page);
+  background: var(--topbar);
+  border-bottom: 1px solid var(--border);
+  position: sticky; top: 0; z-index: 20;
+}
+.crumbs { display: grid; line-height: 1.25; min-width: 0; }
+.crumbs strong { font-size: 14px; }
+.crumbs span { font-size: 12px; color: var(--text-tertiary); }
+.topbar-actions { display: flex; align-items: center; gap: var(--space-sm); margin-left: auto; }
+
+.search {
+  position: relative;
+  width: 300px;
+}
+.search .input { height: 34px; padding-left: 34px; }
+.search .icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-tertiary); width: 15px; height: 15px; }
+.search-panel {
+  position: absolute;
+  top: calc(var(--topbar-height) - 6px);
+  right: var(--space-page);
+  width: min(520px, calc(100vw - 2 * var(--space-page)));
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow);
+  z-index: 40;
+  padding: var(--space-md);
+  display: grid; gap: var(--space-sm);
+}
+.search-result {
+  display: flex; align-items: center; gap: var(--space-md);
+  padding: var(--space-sm) var(--space-md);
+  border-radius: var(--radius-md);
+  cursor: pointer;
+  border: 1px solid transparent;
+}
+.search-result:hover, .search-result:focus-visible { background: var(--hover); border-color: var(--border); }
+.search-result .sub { color: var(--text-tertiary); font-size: 11.5px; }
+
+.panel-pop {
+  position: absolute;
+  top: calc(var(--topbar-height) - 6px);
+  right: var(--space-page);
+  width: min(440px, calc(100vw - 2 * var(--space-page)));
+  max-height: min(560px, calc(100vh - var(--topbar-height) - 32px));
+  overflow: auto;
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow);
+  z-index: 40;
+  padding: var(--space-lg);
+  display: grid; gap: var(--space-md);
+}
+.pop-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }
+.menu {
+  position: absolute;
+  top: calc(var(--topbar-height) - 6px);
+  right: var(--space-page);
+  min-width: 260px;
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow);
+  z-index: 40;
+  padding: var(--space-sm);
+  display: grid; gap: 2px;
+}
+.menu-identity { padding: var(--space-md); border-bottom: 1px solid var(--border); margin-bottom: var(--space-xs); }
+.menu-identity strong { display: block; font-size: 13.5px; }
+.menu-identity span { font-size: 11.5px; color: var(--text-tertiary); }
+.menu-item {
+  display: flex; align-items: center; gap: var(--space-md);
+  padding: var(--space-sm) var(--space-md);
+  border: none; background: transparent; border-radius: var(--radius-sm);
+  width: 100%; text-align: left; cursor: pointer; color: var(--text-primary);
+}
+.menu-item:hover { background: var(--hover); }
+.menu-item.danger { color: var(--danger); }
+.avatar {
+  width: 28px; height: 28px; border-radius: 50%;
+  background: var(--primary-soft); color: var(--primary);
+  display: grid; place-items: center; font-weight: 700; font-size: 12px;
+}
+.identity-button {
+  display: flex; align-items: center; gap: var(--space-sm);
+  padding: var(--space-xs) var(--space-sm);
+  border: 1px solid transparent; border-radius: var(--radius-pill);
+  background: transparent; cursor: pointer;
+}
+.identity-button:hover { background: var(--hover); }
+.identity-button .who { display: grid; line-height: 1.2; text-align: left; }
+.identity-button .who strong { font-size: 12.5px; }
+.identity-button .who span { font-size: 11px; color: var(--text-tertiary); }
+
+.content { padding: var(--space-page); flex: 1; min-width: 0; }
+.content-inner { max-width: var(--content-max); margin: 0 auto; display: grid; gap: var(--space-xxl); }
+.drawer-scrim { position: fixed; inset: 0; background: rgba(8, 12, 20, 0.45); z-index: 25; }
+
+/* --------------------------------------------------------------------------
+   Panels, sections, grids
+   -------------------------------------------------------------------------- */
+
+.panel {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-lg);
+}
+.panel.pad-0 { padding: 0; overflow: hidden; }
+.panel-head {
+  display: flex; align-items: flex-start; gap: var(--space-md);
+  padding-bottom: var(--space-md);
+  border-bottom: 1px solid var(--border);
+  margin-bottom: var(--space-md);
+}
+.panel.pad-0 .panel-head { padding: var(--space-lg); margin: 0; }
+.panel-head .grow { display: grid; gap: 2px; }
+.panel-head h2 { font-size: 15px; }
+.panel-head .sub { font-size: 12px; color: var(--text-secondary); }
+.panel-actions { display: flex; align-items: center; gap: var(--space-sm); flex-wrap: wrap; }
+
+.section { display: grid; gap: var(--space-lg); }
+.section-head { display: flex; align-items: flex-start; gap: var(--space-md); }
+.section-head .grow { display: grid; gap: 2px; }
+.section-head h2 { font-size: 16px; }
+.section-head .sub { font-size: 12px; color: var(--text-secondary); }
+.section-actions { margin-left: auto; display: flex; gap: var(--space-sm); flex-wrap: wrap; }
+
+.grid { display: grid; gap: var(--space-lg); }
+.grid-metrics { grid-template-columns: repeat(auto-fill, minmax(216px, 1fr)); }
+.grid-2 { grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); }
+.grid-3 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
+.grid-actions { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
+.split-3-2 { display: grid; gap: var(--space-lg); grid-template-columns: 3fr 2fr; }
+.split-1-1 { display: grid; gap: var(--space-lg); grid-template-columns: 1fr 1fr; }
+.split-3-1 { display: grid; gap: var(--space-lg); grid-template-columns: 3fr 1fr; align-items: start; }
+
+/* --------------------------------------------------------------------------
+   Metric cards
+   -------------------------------------------------------------------------- */
+
+.metric {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  padding: var(--space-lg);
+  display: grid; gap: var(--space-sm);
+  position: relative;
+  overflow: hidden;
+}
+.metric .top { display: flex; align-items: center; gap: var(--space-sm); }
+.metric .icon-wrap {
+  width: 26px; height: 26px; border-radius: var(--radius-sm);
+  background: var(--surface-muted);
+  display: grid; place-items: center; color: var(--text-secondary);
+}
+.metric .label { font-size: 12.5px; color: var(--text-secondary); font-weight: 550; }
+.metric .value { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; }
+.metric .context { font-size: 11.5px; color: var(--text-secondary); }
+.metric .spark { height: 28px; margin-top: var(--space-xs); }
+.metric.is-accent-success .value { color: var(--success); }
+.metric.is-accent-warning .value { color: var(--warning); }
+.metric.is-accent-danger .value { color: var(--danger); }
+
+/* --------------------------------------------------------------------------
+   Badges and status
+   -------------------------------------------------------------------------- */
+
+.badge {
+  display: inline-flex; align-items: center; gap: 6px;
+  padding: 3px var(--space-sm);
+  border-radius: var(--radius-pill);
+  font-size: 11.5px; font-weight: 650;
+  background: var(--surface-muted); color: var(--text-secondary);
+  white-space: nowrap;
+}
+.badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
+.badge .icon { width: 12px; height: 12px; }
+.badge-success { background: var(--success-soft); color: var(--success); }
+.badge-warning { background: var(--warning-soft); color: var(--warning); }
+.badge-danger { background: var(--danger-soft); color: var(--danger); }
+.badge-info { background: var(--info-soft); color: var(--info); }
+.badge-primary { background: var(--primary-soft); color: var(--primary); }
+.badge-neutral { background: var(--surface-muted); color: var(--text-secondary); }
+
+/* --------------------------------------------------------------------------
+   Tables
+   -------------------------------------------------------------------------- */
+
+.table-wrap { overflow-x: auto; }
+table { width: 100%; border-collapse: collapse; font-size: 13px; }
+thead th {
+  position: sticky; top: 0;
+  text-align: left;
+  padding: var(--space-sm) var(--space-md);
+  background: var(--surface-muted);
+  color: var(--text-tertiary);
+  font-size: 11px; font-weight: 650; letter-spacing: 0.05em; text-transform: uppercase;
+  white-space: nowrap;
+}
+thead th:first-child { border-top-left-radius: var(--radius-sm); }
+thead th:last-child { border-top-right-radius: var(--radius-sm); }
+tbody td {
+  padding: var(--space-md);
+  border-bottom: 1px solid var(--border);
+  vertical-align: middle;
+}
+tbody tr:hover { background: var(--hover); }
+tbody tr:last-child td { border-bottom: none; }
+td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
+.cell-primary { font-weight: 600; }
+.cell-actions { display: flex; gap: var(--space-sm); justify-content: flex-end; }
+
+/* --------------------------------------------------------------------------
+   Timeline, notifications, activity
+   -------------------------------------------------------------------------- */
+
+.timeline { display: grid; gap: 0; }
+.timeline-item { display: grid; grid-template-columns: 28px 1fr; gap: var(--space-md); }
+.timeline-rail { display: grid; justify-items: center; position: relative; }
+.timeline-rail::before {
+  content: ""; position: absolute; top: 26px; bottom: 0;
+  width: 1px; background: var(--border);
+}
+.timeline-item:last-child .timeline-rail::before { display: none; }
+.timeline-marker {
+  width: 26px; height: 26px; border-radius: 50%;
+  display: grid; place-items: center;
+  background: var(--surface-muted); color: var(--text-secondary);
+  border: 1px solid var(--border);
+}
+.timeline-body { padding-bottom: var(--space-lg); display: grid; gap: 2px; }
+.timeline-body .title { font-weight: 600; font-size: 13px; }
+.timeline-body .detail { font-size: 12.5px; color: var(--text-secondary); word-break: break-word; }
+.timeline-body .meta { font-size: 11.5px; color: var(--text-tertiary); }
+.timeline-item.sev-critical .timeline-marker { background: var(--danger-soft); color: var(--danger); border-color: transparent; }
+.timeline-item.sev-warning .timeline-marker { background: var(--warning-soft); color: var(--warning); border-color: transparent; }
+.timeline-item.sev-info .timeline-marker { background: var(--info-soft); color: var(--info); border-color: transparent; }
+
+.notification {
+  display: grid; grid-template-columns: 26px 1fr; gap: var(--space-md);
+  padding: var(--space-md);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  background: var(--surface);
+}
+.notification .body { display: grid; gap: 2px; }
+.notification .title { font-weight: 600; font-size: 12.5px; }
+.notification .detail { font-size: 12px; color: var(--text-secondary); }
+.notification .meta { font-size: 11px; color: var(--text-tertiary); }
+
+/* --------------------------------------------------------------------------
+   States: empty, error, loading
+   -------------------------------------------------------------------------- */
+
+.state {
+  display: grid; justify-items: center; gap: var(--space-sm);
+  padding: var(--space-xxxl) var(--space-lg);
+  text-align: center;
+  color: var(--text-secondary);
+}
+.state .icon-wrap {
+  width: 40px; height: 40px; border-radius: 50%;
+  background: var(--surface-muted); display: grid; place-items: center; color: var(--text-tertiary);
+}
+.state strong { font-size: 14px; color: var(--text-primary); }
+.state p { font-size: 12.5px; max-width: 52ch; }
+.state.error .icon-wrap { background: var(--danger-soft); color: var(--danger); }
+.skeleton {
+  border-radius: var(--radius-sm);
+  background: linear-gradient(90deg, var(--surface-muted) 25%, var(--border) 37%, var(--surface-muted) 63%);
+  background-size: 400% 100%;
+  animation: shimmer 1.4s ease-in-out infinite;
+  height: 14px;
+}
+.skeleton.h-lg { height: 20px; }
+.skeleton.h-xl { height: 96px; }
+.skeleton.w-40 { width: 40%; }
+.skeleton.w-60 { width: 60%; }
+.skeleton-card { padding: var(--space-lg); display: grid; gap: var(--space-md); }
+@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
+.spinner {
+  width: 16px; height: 16px; border-radius: 50%;
+  border: 2px solid var(--border-strong); border-top-color: var(--primary);
+  animation: spin 0.7s linear infinite;
+}
+@keyframes spin { to { transform: rotate(360deg); } }
+
+/* --------------------------------------------------------------------------
+   Controls: segmented, search bar, filter bar
+   -------------------------------------------------------------------------- */
+
+.segmented {
+  display: inline-flex; padding: 2px;
+  background: var(--surface-muted);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+}
+.segmented button {
+  border: none; background: transparent; cursor: pointer;
+  padding: 5px var(--space-md);
+  border-radius: var(--radius-sm);
+  font-size: 12px; font-weight: 600; color: var(--text-secondary);
+}
+.segmented button[aria-pressed="true"] { background: var(--surface); color: var(--text-primary); box-shadow: var(--shadow); }
+
+.filter-bar { display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: center; }
+.filter-bar .input { height: 34px; max-width: 260px; }
+.filter-chip {
+  display: inline-flex; align-items: center; gap: 6px;
+  padding: 4px var(--space-sm);
+  border-radius: var(--radius-pill);
+  background: var(--primary-soft); color: var(--primary);
+  font-size: 11.5px; font-weight: 600;
+}
+
+/* --------------------------------------------------------------------------
+   Charts
+   -------------------------------------------------------------------------- */
+
+.chart-card { display: grid; gap: var(--space-md); }
+.chart-canvas-wrap { position: relative; width: 100%; }
+.chart-canvas-wrap canvas { display: block; width: 100%; }
+.legend { display: grid; gap: var(--space-sm); }
+.legend-item { display: flex; align-items: center; gap: var(--space-sm); font-size: 12.5px; }
+.legend-swatch { width: 10px; height: 10px; border-radius: 3px; flex: 0 0 10px; }
+.legend-value { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--text-secondary); }
+
+.meter { height: 6px; border-radius: var(--radius-pill); background: var(--surface-muted); overflow: hidden; position: relative; }
+.meter > span { display: block; height: 100%; border-radius: var(--radius-pill); background: var(--primary); }
+.meter.threshold::after {
+  content: ""; position: absolute; top: -2px; bottom: -2px; width: 2px;
+  background: var(--text-tertiary); border-radius: 1px;
+}
+.health-row {
+  display: grid; gap: var(--space-sm);
+  padding: var(--space-md) 0;
+  border-bottom: 1px solid var(--border);
+}
+.health-row:last-child { border-bottom: none; }
+.health-main { display: flex; align-items: center; gap: var(--space-sm); }
+.health-main .label { font-weight: 600; }
+.health-main .reading { margin-left: auto; font-family: var(--font-mono); font-size: 12px; }
+.health-detail { display: flex; align-items: center; gap: var(--space-sm); font-size: 11.5px; color: var(--text-secondary); }
+.health-detail .when { margin-left: auto; color: var(--text-tertiary); }
+.gauge-grid { display: grid; gap: var(--space-lg); grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
+.gauge { display: grid; justify-items: center; gap: var(--space-xs); }
+.gauge canvas { display: block; }
+.gauge .gauge-label { font-size: 12.5px; font-weight: 600; }
+.gauge .gauge-sub { font-size: 11.5px; color: var(--text-tertiary); }
+
+/* --------------------------------------------------------------------------
+   Quick actions, privacy note, stat rows
+   -------------------------------------------------------------------------- */
+
+.quick-action {
+  display: flex; align-items: center; gap: var(--space-md);
+  height: 52px; padding: 0 var(--space-md);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--surface);
+  cursor: pointer;
+  text-align: left;
+  width: 100%;
+}
+.quick-action:hover { background: var(--surface-muted); }
+.quick-action .icon { color: var(--text-secondary); }
+.quick-action .chev { margin-left: auto; color: var(--text-tertiary); }
+.note {
+  display: flex; gap: var(--space-md); align-items: flex-start;
+  padding: var(--space-lg);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--surface);
+}
+.note .icon { color: var(--text-secondary); margin-top: 2px; }
+.note strong { display: block; font-size: 13.5px; }
+.note p { font-size: 12.5px; color: var(--text-secondary); margin-top: 2px; }
+.stat-row { display: flex; flex-wrap: wrap; gap: var(--space-xl); }
+.stat { display: grid; gap: 2px; }
+.stat .stat-label { font-size: 11px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-tertiary); }
+.stat .stat-value { font-size: 15px; font-weight: 650; }
+.headline {
+  display: flex; align-items: center; gap: var(--space-sm);
+  padding: var(--space-md);
+  border-radius: var(--radius-md);
+  font-weight: 600; font-size: 13px;
+}
+.headline-danger { background: var(--danger-soft); color: var(--danger); }
+.headline-warning { background: var(--warning-soft); color: var(--warning); }
+.headline-success { background: var(--success-soft); color: var(--success); }
+
+/* --------------------------------------------------------------------------
+   Modal + toast
+   -------------------------------------------------------------------------- */
+
+.modal-scrim {
+  position: fixed; inset: 0; z-index: 60;
+  background: rgba(8, 12, 20, 0.5);
+  display: grid; place-items: center;
+  padding: var(--space-page);
+}
+.modal {
+  width: min(440px, 100%);
+  background: var(--surface-raised);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  box-shadow: var(--shadow);
+  padding: var(--space-xl);
+  display: grid; gap: var(--space-md);
+}
+.modal h2 { font-size: 16px; }
+.modal p { font-size: 13px; color: var(--text-secondary); }
+.modal-actions { display: flex; justify-content: flex-end; gap: var(--space-sm); margin-top: var(--space-sm); }
+.toast-host {
+  position: fixed; right: var(--space-page); bottom: var(--space-page);
+  z-index: 80; display: grid; gap: var(--space-sm); justify-items: end;
+}
+.toast {
+  display: flex; align-items: center; gap: var(--space-sm);
+  background: var(--text-primary); color: var(--background);
+  padding: var(--space-md) var(--space-lg);
+  border-radius: var(--radius-md);
+  box-shadow: var(--shadow);
+  font-size: 12.5px; font-weight: 550;
+  max-width: 380px;
+  animation: toast-in 160ms ease;
+}
+.toast.error { background: var(--danger); color: #fff; }
+@keyframes toast-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+
+/* --------------------------------------------------------------------------
+   Responsive
+   -------------------------------------------------------------------------- */
+
+@media (max-width: 1240px) {
+  .split-3-2, .split-1-1, .split-3-1 { grid-template-columns: 1fr; }
+}
+
+@media (max-width: 1000px) {
+  .auth { grid-template-columns: 1fr; }
+  .auth-brand { display: none; }
+  .sidebar {
+    position: fixed; inset: 0 auto 0 0;
+    transform: translateX(-100%);
+    transition: transform 180ms ease;
+    box-shadow: var(--shadow);
+  }
+  .app.drawer-open .sidebar { transform: none; }
+  .app.collapsed .sidebar { width: var(--sidebar-width); flex-basis: var(--sidebar-width); }
+  .app.collapsed .nav-label, .app.collapsed .nav-badge,
+  .app.collapsed .nav-group-title, .app.collapsed .brand-text { display: revert; }
+  .app.collapsed .nav-item { justify-content: flex-start; padding: 0 var(--space-md); }
+  .app.collapsed .sidebar-head { justify-content: flex-start; }
+  .search { width: 200px; }
+}
+
+@media (max-width: 720px) {
+  :root { --space-page: 14px; }
+  .content-inner { gap: var(--space-lg); }
+  .grid-metrics { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
+  .search { display: none; }
+  .crumbs span { display: none; }
+  .split-3-2, .split-1-1, .split-3-1, .grid-2, .grid-3 { grid-template-columns: 1fr; }
+  .panel { padding: var(--space-md); }
+  .modal { padding: var(--space-lg); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
+  .skeleton { background: var(--surface-muted); }
+}
diff --git a/internal/httpapi/adminweb/views.js b/internal/httpapi/adminweb/views.js
new file mode 100644
index 0000000..a9a3627
--- /dev/null
+++ b/internal/httpapi/adminweb/views.js
@@ -0,0 +1,1148 @@
+/* ===========================================================================
+   LocalLink admin console — modules.
+
+   Each view declares the role it needs, fetches only from the admin API and
+   renders real server values. A section whose request failed shows its own
+   error state with a retry; a section with no data shows an explicit empty
+   state. No value shown is invented client-side.
+   =========================================================================== */
+window.LL = window.LL || {};
+LL.views = {};
+
+(function () {
+  'use strict';
+
+  const ui = LL.ui;
+  const fmt = LL.fmt;
+
+  // ------------------------------------------------------------- small helpers
+  async function settle(promise) {
+    try {
+      return { ok: true, data: await promise };
+    } catch (err) {
+      return { ok: false, error: (err && err.message) || String(err) };
+    }
+  }
+
+  function panelResult(result, options, render) {
+    const o = options || {};
+    if (!result.ok) {
+      return ui.panel({
+        title: o.title,
+        subtitle: o.subtitle,
+        body: ui.errorState(result.error, o.retryId),
+      });
+    }
+    return render(result.data);
+  }
+
+  function num(value) {
+    const n = Number(value);
+    return isFinite(n) ? n : 0;
+  }
+
+  function emptyText(value) {
+    return value === null || value === undefined || value === '' ? '—' : ui.esc(value);
+  }
+
+  const RANGE_LABELS = { '24h': 'last 24 hours', '7d': 'last 7 days', '30d': 'last 30 days', '90d': 'last 90 days' };
+  const LONG_RANGES = { '30d': true, '90d': true };
+
+  function rangeWindowLabel(range) {
+    return RANGE_LABELS[range] || RANGE_LABELS['24h'];
+  }
+
+  function seriesToList(raw, longRange) {
+    if (!Array.isArray(raw)) return [];
+    return raw
+      .filter((p) => p && typeof p === 'object')
+      .map((p) => ({ label: fmt.bucket(p.t, longRange), value: num(p.v) }));
+  }
+
+  function sparkValues(raw) {
+    if (!Array.isArray(raw)) return [];
+    return raw.map((p) => num(p && p.v));
+  }
+
+  function paintSparklines(root) {
+    root.querySelectorAll('[data-sparkline]').forEach((host) => {
+      let values = [];
+      try { values = JSON.parse(host.getAttribute('data-sparkline') || '[]'); } catch (err) { values = []; }
+      if (!values.length) return;
+      const canvas = document.createElement('canvas');
+      host.appendChild(canvas);
+      LL.charts.sparkline(canvas, values, ui.token('primary', '#1e5bff'));
+    });
+  }
+
+  function afterRender(root) {
+    paintSparklines(root);
+    root.querySelectorAll('canvas[data-chart]').forEach((canvas) => {
+      let spec = null;
+      try { spec = JSON.parse(canvas.getAttribute('data-spec') || 'null'); } catch (err) { spec = null; }
+      if (!spec) return;
+      if (spec.type === 'line') LL.charts.line(canvas, spec.options);
+      else if (spec.type === 'bar') LL.charts.bar(canvas, spec.options);
+      else if (spec.type === 'donut') LL.charts.donut(canvas, spec.options);
+      else if (spec.type === 'gauge') LL.charts.gauge(canvas, spec.options);
+    });
+  }
+
+  function chartCanvas(spec, height) {
+    return `<div class="chart-canvas-wrap" style="height:${height}px">
+      <canvas data-chart="${spec.type}" data-spec='${JSON.stringify(spec).replace(/'/g, '&#39;')}'></canvas>
+    </div>`;
+  }
+
+  function tableActions(buttons) {
+    return `<div class="cell-actions">${buttons.join('')}</div>`;
+  }
+
+  // ------------------------------------------------------------------ dashboard
+  const dashboard = {
+    id: 'dashboard',
+    title: 'Dashboard',
+    subtitle: 'Operational overview',
+    icon: 'i-dashboard',
+    group: 'Operations',
+    async mount(el, ctx) {
+      const range = ctx.state.analyticsRange || '24h';
+      const longRange = !!LONG_RANGES[range];
+
+      el.innerHTML = `<div class="section">${ui.skeletonCards(8)}</div>`;
+
+      const [analytics, health, security, activity, summary, network, settings] = await Promise.all([
+        settle(ctx.api('/api/v1/admin/analytics?range=' + encodeURIComponent(range))),
+        settle(ctx.api('/api/v1/admin/health')),
+        settle(ctx.api('/api/v1/admin/security-summary')),
+        settle(ctx.api('/api/v1/admin/activity?limit=40')),
+        settle(ctx.api('/api/v1/admin/summary')),
+        settle(ctx.api('/api/v1/admin/network')),
+        settle(ctx.api('/api/v1/admin/settings')),
+      ]);
+
+      if (settings.ok && settings.data) {
+        ctx.setRefreshSeconds(settings.data.dashboard_refresh_seconds);
+      }
+
+      const series = (analytics.ok && analytics.data.series) || {};
+      const totals = (analytics.ok && analytics.data.totals) || {};
+      const runtime = (analytics.ok && analytics.data.runtime) || { available: false };
+      const summaryData = summary.ok ? summary.data : null;
+      const networkData = network.ok ? network.data : null;
+      const securityCounts = (security.ok && security.data.counts) || {};
+      const securityEvents = (security.ok && security.data.recent_events) || [];
+      const activityEvents = (activity.ok && activity.data.events) || [];
+      const healthComponents = (health.ok && health.data.components) || [];
+      const overall = health.ok ? health.data.overall : 'unknown';
+      const windowLabel = rangeWindowLabel(range);
+
+      const parts = [];
+
+      // ---- header
+      parts.push(`<div class="section-head">
+        <div class="grow">
+          <h1 class="type-page-title">Overview</h1>
+          <span class="sub">${analytics.ok && analytics.data.generated_at
+            ? 'Updated ' + ui.esc(fmt.relative(analytics.data.generated_at)) + ' · '
+            : ''}Operational metadata from the LocalLink server.</span>
+        </div>
+        <div class="section-actions">
+          ${ui.badge('Range: ' + ui.esc(range), 'primary')}
+          ${ui.statusBadge(overall, { label: 'Overall: ' + ui.statusInfo(overall).label })}
+        </div>
+      </div>`);
+
+      // ---- metric area
+      const metricCards = [];
+      if (summaryData) {
+        metricCards.push(ui.metricCard({
+          label: 'Total users', value: fmt.number(summaryData.users), icon: 'i-users',
+          context: `+${fmt.number(num(totals.users))} ${windowLabel}`, sparkline: sparkValues(series.users),
+        }));
+        metricCards.push(ui.metricCard({
+          label: 'Online devices', value: fmt.number(summaryData.online_devices), icon: 'i-wifi',
+          context: `of ${fmt.number(summaryData.devices)} registered`,
+        }));
+        metricCards.push(ui.metricCard({
+          label: 'Registered devices', value: fmt.number(summaryData.devices), icon: 'i-devices',
+          context: `+${fmt.number(num(totals.devices))} ${windowLabel}`, sparkline: sparkValues(series.devices),
+        }));
+        metricCards.push(ui.metricCard({
+          label: 'Messages', value: fmt.number(summaryData.messages), icon: 'i-activity',
+          context: `+${fmt.number(num(totals.messages))} ${windowLabel}`, sparkline: sparkValues(series.messages),
+        }));
+        metricCards.push(ui.metricCard({
+          label: 'Active calls', value: fmt.number(summaryData.active_calls), icon: 'i-call',
+          context: `${fmt.number(num(totals.calls))} started ${windowLabel}`,
+        }));
+        metricCards.push(ui.metricCard({
+          label: 'Active sessions', value: fmt.number(summaryData.active_sessions), icon: 'i-key',
+          context: 'Authenticated device sessions',
+        }));
+        metricCards.push(ui.metricCard({
+          label: 'Storage used', value: fmt.bytes(summaryData.file_storage_bytes), icon: 'i-database',
+          context: `Database ${fmt.bytes(summaryData.db_bytes)}`,
+        }));
+        metricCards.push(ui.metricCard({
+          label: 'Security alerts', value: fmt.number(summaryData.security_alerts), icon: 'i-shield',
+          accent: num(summaryData.security_alerts) > 0 ? 'warning' : 'success',
+          context: 'Events in the last 24 hours', sparkline: sparkValues(series.security_events),
+        }));
+      } else {
+        metricCards.push(`<div class="state error" style="grid-column:1/-1">
+          ${ui.icon('i-alert')}<strong>Metrics unavailable</strong>
+          <p>${ui.esc(summary.error || 'The summary endpoint did not respond.')}</p>
+          <button class="btn btn-sm" data-retry="dashboard">${ui.icon('i-refresh')}Retry</button></div>`);
+      }
+      parts.push(`<div class="grid grid-metrics">${metricCards.join('')}</div>`);
+
+      // ---- analytics
+      const messagePoints = seriesToList(series.messages, longRange);
+      const runtimeAvailable = !!runtime.available;
+      const bytePoints = runtimeAvailable ? seriesToList(series.network_bytes, longRange) : [];
+      const rangeSelector = ui.segmented([
+        { value: '24h', label: '24H' }, { value: '7d', label: '7D' },
+        { value: '30d', label: '30D' }, { value: '90d', label: '90D' },
+      ], range, 'data-range');
+
+      const allZero = (list) => list.length === 0 || list.every((p) => p.value === 0);
+      const messageChart = messagePoints.length && !allZero(messagePoints)
+        ? chartCanvas({ type: 'line', options: { points: messagePoints, color: ui.token('primary', '#1e5bff'), height: 220, xLabelCount: 6, longRange } }, 220)
+        : ui.emptyState({ icon: 'i-activity', title: 'No messages in this window', message: 'The server accepted no messages during the selected period.' });
+      const byteChart = !runtimeAvailable
+        ? ui.emptyState({ icon: 'i-activity', title: 'Traffic metrics unavailable', message: 'This server build does not expose the runtime sampler.' })
+        : (bytePoints.length && !allZero(bytePoints)
+          ? chartCanvas({ type: 'line', options: { points: bytePoints, color: ui.token('info', '#0b5fa5'), height: 200, xLabelCount: 6, longRange } }, 200)
+          : ui.emptyState({ icon: 'i-activity', title: 'No response traffic', message: 'No bytes were served during the selected period.' }));
+
+      parts.push(`<section class="section">
+        ${ui.sectionHead({ title: 'Activity analytics', subtitle: 'Rollups computed from platform tables and the runtime sampler', icon: 'i-activity', actions: rangeSelector })}
+        <div class="split-3-2">
+          ${ui.panel({ title: 'Message activity', subtitle: 'Messages accepted by the server per bucket', body: messageChart })}
+          ${ui.panel({ title: 'Server traffic', subtitle: runtimeAvailable ? 'Response bytes served per bucket' : 'Requires the runtime metrics sampler', body: byteChart })}
+        </div>
+      </section>`);
+
+      // ---- health
+      const gaugeKeys = ['cpu', 'memory', 'storage'];
+      const gaugeTones = { healthy: 'var(--success)', warning: 'var(--warning)', critical: 'var(--danger)', unknown: 'var(--text-tertiary)', offline: 'var(--text-secondary)' };
+      const gauges = healthComponents.filter((c) => gaugeKeys.indexOf(c.key) >= 0);
+      const gaugeHtml = gauges.map((c) => {
+        const tone = ui.statusInfo(c.status).tone;
+        const color = gaugeTones[ui.statusInfo(c.status).tone] || gaugeTones[tone];
+        return `<div class="gauge">
+          ${chartCanvas({ type: 'gauge', options: { value: num(c.value), max: 100, threshold: c.threshold != null ? num(c.threshold) : null, color: color, size: 132 } }, 132)}
+          <span class="gauge-label">${ui.esc(c.label || c.key)}</span>
+          <span class="gauge-sub">${ui.esc(c.unit === '%' && c.threshold != null ? 'threshold ' + num(c.threshold) + '%' : (c.unit ? fmt.number(c.value) + ' ' + c.unit : ''))}</span>
+        </div>`;
+      }).join('');
+
+      const healthBody = !health.ok
+        ? ui.errorState(health.error, 'dashboard')
+        : (healthComponents.length
+          ? `<div class="split-3-1">
+              <div>${healthComponents.map(ui.healthRow).join('')}</div>
+              ${gauges.length ? `<div class="gauge-grid" style="grid-template-columns:1fr">${gaugeHtml}</div>` : '<div></div>'}
+            </div>`
+          : ui.emptyState({ icon: 'i-pulse', title: 'No health readings', message: 'The server did not return subsystem readings for this request.' }));
+
+      parts.push(`<section class="section">
+        ${ui.sectionHead({ title: 'Server health', subtitle: 'Percentages are live readings; the tick marks the alert threshold', icon: 'i-pulse', actions: ui.statusBadge(overall) })}
+        ${ui.panel({ body: healthBody })}
+      </section>`);
+
+      // ---- network + security
+      let networkBody;
+      if (!networkData) {
+        networkBody = ui.errorState(network.error || 'The network endpoint did not respond.', 'dashboard');
+      } else {
+        const online = num(networkData.online_devices);
+        const registered = num(networkData.devices);
+        const offline = Math.max(0, registered - online);
+        const segments = [
+          { label: 'Server connected', value: num(networkData.server_connected), color: 'var(--success)' },
+          { label: 'LAN available', value: num(networkData.lan_available), color: 'var(--primary)' },
+          { label: 'Wi-Fi Direct', value: num(networkData.wifi_direct_connected), color: 'var(--info)' },
+          { label: 'Mesh capable', value: num(networkData.mesh_available), color: 'var(--warning)' },
+          { label: 'Offline / idle', value: offline, color: 'var(--border-strong)' },
+        ];
+        const withColors = segments.map((s) => Object.assign({}, s, { color: cssVarToHex(s.color) }));
+        networkBody = `<div class="row gap-lg" style="align-items:center;flex-wrap:wrap">
+            <div style="width:150px;height:150px">${chartCanvas({ type: 'donut', options: { segments: withColors, size: 148, centerValue: fmt.number(online), centerLabel: 'online' } }, 148)}</div>
+            <div class="legend grow">${withColors.map((s) => `<div class="legend-item">
+              <span class="legend-swatch" style="background:${s.color}"></span>
+              <span>${ui.esc(s.label)}</span><span class="legend-value">${fmt.number(s.value)}</span></div>`).join('')}</div>
+          </div>
+          <div class="health-detail" style="margin-top:12px">
+            ${ui.statRow([
+              { label: 'Server links', value: fmt.number(networkData.server_connected) },
+              { label: 'LAN', value: fmt.number(networkData.lan_available) },
+              { label: 'Wi-Fi Direct', value: fmt.number(networkData.wifi_direct_connected) },
+              { label: 'Mesh', value: fmt.number(networkData.mesh_available) },
+              { label: 'Registered', value: fmt.number(registered) },
+              { label: 'Pending transfers', value: fmt.number(networkData.pending_transfers) },
+            ])}
+          </div>`;
+      }
+
+      let securityBody;
+      if (!security.ok) {
+        securityBody = ui.errorState(security.error, 'dashboard');
+      } else {
+        const critical = num(securityCounts.critical_alerts_24h);
+        const failed = num(securityCounts.failed_logins_24h);
+        const head = critical > 0
+          ? ui.headline('danger', `${critical} critical alert${critical === 1 ? '' : 's'} in 24h`, 'i-alert')
+          : (failed > 0
+            ? ui.headline('warning', `${failed} failed login${failed === 1 ? '' : 's'} in 24h`, 'i-alert')
+            : ui.headline('success', 'No critical security alerts in 24h', 'i-check'));
+        securityBody = `${head}
+          <div style="margin-top:12px">${ui.statRow([
+            { label: 'Failed logins 24h', value: fmt.number(failed) },
+            { label: 'Locked users', value: fmt.number(securityCounts.locked_users) },
+            { label: 'Revoked devices', value: fmt.number(securityCounts.revoked_devices) },
+            { label: 'Active sessions', value: fmt.number(securityCounts.active_sessions) },
+            { label: 'Pending recoveries', value: fmt.number(securityCounts.pending_recoveries) },
+          ])}</div>
+          ${securityEvents.length ? `<div style="margin-top:16px;display:grid;gap:8px">
+            <span class="type-label">Recent security events</span>
+            ${securityEvents.slice(0, 4).map((e) => ui.notificationItem({
+              icon: ui.severityIcon(e.severity), title: fmt.titleCase(e.action), detail: e.detail,
+              timestamp: e.created_at, severity: e.severity,
+            })).join('')}
+          </div>` : ''}`;
+      }
+
+      parts.push(`<div class="section">
+        <div class="split-1-1">
+          ${ui.panel({
+            title: 'Live network', subtitle: 'Transport state reported by connected devices',
+            actions: `<button class="btn btn-sm" data-nav="network">Open network topology</button>`,
+            body: networkBody,
+          })}
+          ${ui.panel({
+            title: 'Security overview', subtitle: 'Audited events, sessions and outstanding recovery work',
+            actions: `<button class="btn btn-sm" data-nav="security">Security center</button>
+                      <button class="btn btn-sm" data-nav="audit">Audit log</button>`,
+            body: securityBody,
+          })}
+        </div>
+      </div>`);
+
+      // ---- activity
+      const timelineEntries = activityEvents.map((e) => ({
+        title: e.title, detail: e.detail, timestamp: e.created_at, severity: e.severity,
+        icon: activityIcon(e.type),
+      }));
+      parts.push(ui.panel({
+        title: 'Recent activity',
+        subtitle: 'Newest first, merged across users, devices, files, calls and audit sources',
+        actions: `<button class="btn btn-sm" data-nav="audit">Open audit log</button>`,
+        body: !activity.ok
+          ? ui.errorState(activity.error, 'dashboard')
+          : ui.timeline(timelineEntries, { max: 10, emptyMessage: 'No operational events have been recorded on this server yet.' }),
+      }));
+
+      // ---- quick actions
+      const actions = [
+        { id: 'users', label: 'Manage users', icon: 'i-users' },
+        { id: 'devices', label: 'Manage devices', icon: 'i-devices' },
+        { id: 'security', label: 'Review security', icon: 'i-flag' },
+        { id: 'network', label: 'View network', icon: 'i-hub' },
+        { id: 'audit', label: 'Audit log', icon: 'i-audit' },
+        { id: 'recovery', label: 'Recovery queue', icon: 'i-restore' },
+        { id: 'diagnostics', label: 'System health', icon: 'i-pulse' },
+      ];
+      if (ctx.can('manageSettings')) actions.push({ id: 'settings', label: 'Server settings', icon: 'i-settings' });
+      if (ctx.can('backup')) actions.push({ id: 'backup', label: 'Create backup', icon: 'i-backup' });
+      // Trim the list to what this role may actually open.
+      const permitted = actions.filter((a) => !LL.moduleRoles[a.id] || LL.moduleRoles[a.id].indexOf(ctx.role) >= 0);
+      parts.push(`<section class="section">
+        ${ui.sectionHead({ title: 'Quick actions', subtitle: 'Only actions your admin role permits', icon: 'i-flag' })}
+        <div class="grid grid-actions">${permitted.map((a) => ui.quickAction({
+          label: a.label, icon: a.icon, action: a.id === 'backup' ? 'backup' : 'nav:' + a.id,
+        })).join('')}</div>
+      </section>`);
+
+      parts.push(ui.note('Privacy boundary',
+        'Operational metadata only. Passwords, private keys, message bodies, call audio and decrypted media are never exposed to this console.',
+        'i-lock'));
