+  }
+
+  function headline(tone, text, iconName) {
+    return `<div class="headline headline-${tone}">${icon(iconName || 'i-info')}<span>${esc(text)}</span></div>`;
+  }
+
+  function table(options) {
+    const o = options || {};
+    const columns = o.columns || [];
+    const rows = o.rows || [];
+    if (!rows.length) {
+      return emptyState({
