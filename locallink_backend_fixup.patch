+    </div>`;
+  }
+
+  function filterBar(options) {
+    const o = options || {};
+    const controls = [];
+    if (o.search) {
+      controls.push(`<input class="input" type="search" data-filter-search placeholder="${esc(o.searchPlaceholder || 'Search…')}" value="${esc(o.searchValue || '')}" aria-label="${esc(o.searchPlaceholder || 'Search')}">`);
