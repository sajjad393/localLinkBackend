diff --git a/internal/httpapi/procstats.go b/internal/httpapi/procstats.go
new file mode 100644
index 0000000..fee749a
--- /dev/null
+++ b/internal/httpapi/procstats.go
@@ -0,0 +1,82 @@
+package httpapi
+
+import (
+	"runtime"
+	"sync"
+	"time"
+)
+
+// processSnapshot holds process/host resource readings for the admin health
+// panel. Every reading carries an "ok" flag: a value that cannot be measured on
+// the current platform is reported as unavailable rather than fabricated.
+type processSnapshot struct {
+	CPUPercent  float64
+	CPUOK       bool
+	MemBytes    uint64
+	MemTotal    uint64
+	MemOK       bool
+	DiskFree    uint64
+	DiskTotal   uint64
+	DiskOK      bool
+	GOHeapBytes uint64
+	Goroutines  int
+}
+
+var (
+	procSampleMu  sync.Mutex
+	procPrevAt    time.Time
+	procPrevCPU   float64
+	procPrevOK    bool
+	procLastValue float64
+)
+
+// SampleProcess reads process CPU/memory and host disk usage for dir.
+// CPU percent is derived from the delta between successive samples and is
+// normalised across all cores (0-100).
+func SampleProcess(dir string) processSnapshot {
+	var snap processSnapshot
+
+	cpuSeconds, cpuOK := platformCPUSeconds()
+	memBytes, memTotal, memOK := platformMemory()
+	diskFree, diskTotal, diskOK := platformDisk(dir)
+
+	now := time.Now()
+	procSampleMu.Lock()
+	if cpuOK && procPrevOK {
+		elapsed := now.Sub(procPrevAt).Seconds()
+		if elapsed > 0.05 {
+			delta := cpuSeconds - procPrevCPU
+			if delta >= 0 {
+				cores := float64(numCPUs())
+				if cores < 1 {
+					cores = 1
+				}
+				procLastValue = (delta / elapsed) * 100 / cores
+				if procLastValue < 0 {
+					procLastValue = 0
+				}
+			}
+		}
+		snap.CPUOK = true
+		snap.CPUPercent = procLastValue
+	}
+	if cpuOK {
+		procPrevCPU = cpuSeconds
+		procPrevOK = true
+	} else {
+		procPrevOK = false
+	}
+	procPrevAt = now
+	procSampleMu.Unlock()
+
+	snap.MemBytes, snap.MemTotal, snap.MemOK = memBytes, memTotal, memOK
+	snap.DiskFree, snap.DiskTotal, snap.DiskOK = diskFree, diskTotal, diskOK
+	return snap
+}
+
+func numCPUs() int {
+	if n := runtime.NumCPU(); n > 0 {
+		return n
+	}
+	return 1
+}
diff --git a/internal/httpapi/procstats_linux.go b/internal/httpapi/procstats_linux.go
new file mode 100644
index 0000000..8b52b4d
--- /dev/null
+++ b/internal/httpapi/procstats_linux.go
@@ -0,0 +1,71 @@
+//go:build linux
+
+package httpapi
+
+import (
+	"os"
+	"strconv"
+	"strings"
+	"syscall"
+)
+
+// platformCPUSeconds returns cumulative CPU seconds consumed by this process.
+func platformCPUSeconds() (float64, bool) {
+	data, err := os.ReadFile("/proc/self/stat")
+	if err != nil {
+		return 0, false
+	}
+	fields := strings.Fields(string(data))
+	if len(fields) < 15 {
+		return 0, false
+	}
+	utime, err1 := strconv.ParseFloat(fields[13], 64)
+	stime, err2 := strconv.ParseFloat(fields[14], 64)
+	if err1 != nil || err2 != nil {
+		return 0, false
+	}
+	// /proc reports clock ticks; USER_HZ is 100 on effectively all Linux builds.
+	return (utime + stime) / 100.0, true
+}
+
+func platformMemory() (uint64, uint64, bool) {
+	var rss uint64
+	if data, err := os.ReadFile("/proc/self/statm"); err == nil {
+		fields := strings.Fields(string(data))
+		if len(fields) >= 2 {
+			if pages, err := strconv.ParseUint(fields[1], 10, 64); err == nil {
+				rss = pages * uint64(os.Getpagesize())
+			}
+		}
+	}
+	var total uint64
+	if data, err := os.ReadFile("/proc/meminfo"); err == nil {
+		for _, line := range strings.Split(string(data), "\n") {
+			if strings.HasPrefix(line, "MemTotal:") {
+				fields := strings.Fields(line)
+				if len(fields) >= 2 {
+					if kb, err := strconv.ParseUint(fields[1], 10, 64); err == nil {
+						total = kb * 1024
+					}
+				}
+				break
+			}
+		}
+	}
+	if rss == 0 && total == 0 {
+		return 0, 0, false
+	}
+	return rss, total, true
+}
+
+func platformDisk(path string) (uint64, uint64, bool) {
+	if path == "" {
+		path = "."
+	}
+	var st syscall.Statfs_t
+	if err := syscall.Statfs(path, &st); err != nil {
+		return 0, 0, false
+	}
+	bsize := uint64(st.Bsize)
+	return st.Bavail * bsize, st.Blocks * bsize, true
+}
