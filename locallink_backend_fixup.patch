+// assetNameFor resolves "/admin/app.js" (and "/admin/" or "/admin") to the
+// embedded asset name.
+func assetNameFor(urlPath string) string {
+	trimmed := strings.TrimPrefix(urlPath, "/admin")
+	trimmed = strings.TrimPrefix(trimmed, "/")
+	if trimmed == "" {
+		return "index.html"
+	}
+	return trimmed
